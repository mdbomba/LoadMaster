# LoadMaster MCP Server Configuration
# Copy this file to .env and fill in your LoadMaster details

# Required: LoadMaster IP or hostname
LM_HOST=10.0.0.99

# Optional: API port (default: 443)
LM_PORT=443

# Authentication (choose one method):

# Method 1: Username/password (basic auth)
LM_USERNAME=bal
# Test-only bootstrap password. Change the bal password as soon as possible
# after licensing and do not use this value outside a disposable test VM.
LM_PASSWORD=Kemp1fourall

# Method 2: API key
# LM_API_KEY=your-api-key-here

# Optional: SSL verification (default: false - LoadMaster uses self-signed certs)
LM_VERIFY_SSL=false

# Optional: Request timeout in seconds (default: 30)
LM_TIMEOUT=30

# Optional: libvirt VM name for IP discovery (used during licensing)
# When set, lm_discover_vm_ip and lm_license_full_workflow can find the VM's
# actual DHCP IP even when it differs from LM_HOST.
# LM_VM_NAME=99_vlm99
