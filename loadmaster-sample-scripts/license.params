# Template values only. Copy to ~/.secrets/loadmaster.params and fill in,
# or set LICENSE_PARAMS_FILE to point at your own file. Real credentials
# must not be committed to this repository.

Api_User='bal'
Api_Pass=''
# Test-only bootstrap password. Change the bal password as soon as possible
# after licensing and do not use this value outside a disposable test VM.
New_Api_Pass='Kemp1fourall'
# Management IP of the LoadMaster. Derive the VM name and hostname from the
# last octet: 10.0.0.99 means Vm_Name 99_vlm99 and hostname vlm99.
Api_Ip=''
Api_Port='443'
Vm_Name=''
Progress_User=''      # Only used to generate licenses
Progress_Pass=''                     # Only used to generate licenses
Order_Id=''
License_Type='free'
# Required only for explicitly requested non-Free images: 'trial' or 'paid'.
Non_Free_License_Choice=''
ntphost='pool.ntp.org'
hostname=''
nameserver='8.8.8.8,8.8.4.4'
